{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "pgp2-schedule.vercel.app" }],
      "destination": "https://pgp2.termflow.tech/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
